# Klimr — environment variables (Aug 2026, complete inventory · audit DEP-002)
# Copy to .env.local for development. In production (Vercel → Settings →
# Environment Variables) the REQUIRED block is asserted at boot by lib/env.ts:
# a deploy missing any of them refuses to serve. Keep this file in step with
# lib/env.ts when adding variables.

# ── REQUIRED (boot-asserted in production) ──────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=            # Supabase → Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=       # Supabase → Settings → API → anon/publishable key
SUPABASE_SERVICE_ROLE_KEY=           # Supabase → Settings → API → service_role (SECRET — server only)
CRON_SECRET=                         # finalize-tournaments cron; Vercel sends it as Authorization: Bearer
WAITLIST_CRON_SECRET=                # waitlist sweep; pg_cron (migration 0173) sends it as x-cron-secret
GATE_SECRET=                         # signs the invite-gate 72h claim cookie

# ── RECOMMENDED (warn at boot; features degrade as documented) ──────────────
RESEND_API_KEY=                      # transactional email on notifications.klimr.com
NEXT_PUBLIC_SITE_URL=                # canonical origin, e.g. https://klimr.com
TURNSTILE_SECRET_KEY=                # Cloudflare Turnstile server key — CAPTCHA fails open without it (documented)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=      # Turnstile widget site key
ANTHROPIC_API_KEY=                   # AI global search + courts verifier/judge — features gate off unkeyed
GOOGLE_MAPS_API_KEY=                 # courts live search (Places) — cached areas still serve unkeyed

# ── Courts tuning (defaults in code) ────────────────────────────────────────
COURTS_MONTHLY_LIVE_SEARCH_CAP=      # default 800 — global monthly live-search budget
COURTS_CACHE_TTL_DAYS=               # default 7
COURTS_AI_MODEL=                     # judge model override
COURTS_EXTRACT_MODEL=                # extractor model override

# ── Safety & moderation pipeline ────────────────────────────────────────────
MODERATION_PROVIDER=                 # e.g. openai — enables automated media checks
MODERATION_MODEL=
OPENAI_API_KEY=                      # only if MODERATION_PROVIDER=openai
CSAM_SCAN_PROVIDER=                  # hash-match vendor hook
CSAM_SCAN_WEBHOOK_URL=
CSAM_SCAN_WEBHOOK_TOKEN=
NCMEC_REPORT_WEBHOOK=                # mandated-report relay
NCMEC_REPORT_TOKEN=
SAFETY_ALERT_WEBHOOK=                # ops alert on safety events
SAFETY_DEV_BYPASS=                   # dev only — never set in production

# ── Support-desk integration seam (lib/support-events.ts) ───────────────────
SUPPORT_WEBHOOK_URL=                 # HMAC-signed ticket events → helpdesk
SUPPORT_WEBHOOK_SECRET=

# ── Misc / optional ─────────────────────────────────────────────────────────
NEXT_PUBLIC_MAPBOX_TOKEN=            # map tiles where used
NEXT_PUBLIC_ADSENSE_CLIENT=          # unused unless ads are ever enabled
